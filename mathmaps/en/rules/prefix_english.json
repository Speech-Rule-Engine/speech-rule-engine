{
  "modality": "prefix",
  "domain": "default",
  "locale": "en",
  "inherits": "base",
  "rules": [
    [
      "Rule",
      "cases-case",
      "clearspeak.default",
      "[t] \"Case\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row",
      "@role=\"cases\""
    ],
    [
      "AliasRule",
      "cases-case",
      "self::line",
      "@role=\"cases\""
    ],
    [
      "Rule",
      "row-line",
      "clearspeak.default",
      "[t] \"Line\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-line",
      "self::line"
    ],
    [
      "Rule",
      "row-case",
      "clearspeak.MultiLineLabel_Case",
      "[t] \"Case\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-case",
      "self::line"
    ],
    [
      "Rule",
      "row-equation",
      "clearspeak.MultiLineLabel_Equation",
      "[t] \"Equation\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-equation",
      "self::line"
    ],
    [
      "Rule",
      "row-step",
      "clearspeak.MultiLineLabel_Step",
      "[t] \"Step\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-step",
      "self::line"
    ],
    [
      "Rule",
      "row-row",
      "clearspeak.MultiLineLabel_Row",
      "[t] \"Row\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-row",
      "self::line"
    ],
    [
      "Rule",
      "row-constraint",
      "clearspeak.MultiLineLabel_Constraint",
      "[t] \"Constraint\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row"
    ],
    [
      "AliasRule",
      "row-constraint",
      "self::line"
    ],
    [
      "Rule",
      "cell-simple",
      "clearspeak.default",
      "[t] \"Column\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::cell"
    ],
    [
      "Rule",
      "matrix-row",
      "clearspeak.default",
      "[t] \"Row\"; [t] count(preceding-sibling::*)+1 (pause:200)",
      "self::row",
      "@role=\"matrix\""
    ],
    [
      "AliasRule",
      "matrix-row",
      "self::line",
      "@role=\"matrix\""
    ]
  ]
}
