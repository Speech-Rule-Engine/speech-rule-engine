{
  "locale": "af",
  "modality": "prefix",
  "domain": "default",
  "kind": "actions",
  "rules": [
    [
      "Action",
      "numerator",
      "[t] \"teller\" (pause:200)"
    ],
    [
      "Action",
      "denominator",
      "[t] \"noemer\" (pause:200)"
    ],
    [
      "Action",
      "base",
      "[t] \"Basis\" (pause:200)"
    ],
    [
      "Action",
      "exponent",
      "[t] \"Eksponent\" (pause:200)"
    ],
    [
      "Action",
      "subscript",
      "[t] \"indeks\" (pause:200)"
    ],
    [
      "Action",
      "overscript",
      "[t] \"boskrif\" (pause:200)"
    ],
    [
      "Action",
      "underscript",
      "[t] \"Onderskrif\" (pause:200)"
    ],
    [
      "Action",
      "radicand",
      "[t] \"Radikant\" (pause:200)"
    ],
    [
      "Action",
      "index",
      "[t] \"Indeks\" (pause:200)"
    ],
    [
      "Action",
      "leftsub",
      "[t] \"Linker Onderskrif\" (pause:200)"
    ],
    [
      "Action",
      "leftsub-counted",
      "[t] CSFordinalPosition; [t] \"Linker Onderskrif\" (pause:200)"
    ],
    [
      "Action",
      "leftsuper",
      "[t] \"Linker Boskrif\" (pause:200)"
    ],
    [
      "Action",
      "leftsuper-counted",
      "[t] CSFordinalPosition; [t] \"Linker Boskrif\" (pause:200)"
    ],
    [
      "Action",
      "rightsub",
      "[t] \"Regter Onderskrif\" (pause:200)"
    ],
    [
      "Action",
      "rightsub-counted",
      "[t] CSFordinalPosition; [t] \"Regter Onderskrif\" (pause:200)"
    ],
    [
      "Action",
      "rightsuper",
      "[t] \"Regter Boskrif\" (pause:200)"
    ],
    [
      "Action",
      "rightsuper-counted",
      "[t] CSFordinalPosition; [t] \"Regter Boskrif\" (pause:200)"
    ],
    [
      "Action",
      "choice",
      "[t] \"Beskikbare Hoeveelheid\" (pause:200)"
    ],
    [
      "Action",
      "select",
      "[t] \"Gekose Hoeveelheid\" (pause:200)"
    ],
    [
      "Action",
      "row",
      "[t] CSFordinalPosition; [t] \"Ry\" (pause:200)"
    ],
    [
      "Action",
      "cell",
      "[n] ../..; [t] CSFordinalPosition; [t] \"kolom\" (pause:200)"
    ],
    [
      "Action",
      "cell-simple",
      "[t] CSFordinalPosition; [t] \"Kolom\" (pause:200)"
    ],
    [
      "Action",
      "label",
      "[t] \"Opskrif\" (pause:200)"
    ],
    [
      "Action",
      "cases-case",
      "[t] \"Geval\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-line",
      "[t] \"Lyn\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-case",
      "[t] \"Geval\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-equation",
      "[t] \"Vergelyking\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-step",
      "[t] \"Stap\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-row",
      "[t] \"Ry\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "row-constraint",
      "[t] \"beperking\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "cell-simple-short",
      "[t] \"Kolom\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "cell-short",
      "[n] ../..; [t] \"Kolom\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ],
    [
      "Action",
      "matrix-row",
      "[t] \"Ry\"; [t] count(preceding-sibling::*)+1 (pause:200)"
    ]
  ]
}
