{
  "locale": "fr",
  "domain": "clearspeak",
  "modality": "speech",
  "inherits": "romance",
  "rules": [
    [
      "Precondition",
      "superscript-ordinal-letter",
      "Exponent_Ordinal",
      "self::superscript",
      "name(children/*[2])=\"identifier\"",
      "children/*[2][@role=\"latinletter\"]"
    ],
    [
      "Precondition",
      "superscript-ordinal-number",
      "Exponent_Ordinal",
      "self::superscript",
      "name(children/*[2])=\"number\"",
      "children/*[2][@role=\"integer\"]",
      "children/*[2][text()!=\"2\"]",
      "children/*[2][text()!=\"3\"]"
    ],
    [
      "Precondition",
      "superscript-ordinal-cap",
      "Exponent_Ordinal",
      "self::superscript",
      "name(children/*[2])=\"identifier\"",
      "children/*[2][@role=\"latinletter\"]",
      "children/*[2][@category=\"Lu\"]"
    ],
    [
      "Precondition",
      "element-noarticle",
      "default",
      "self::infixop[contains(@role, \"element\")]"
    ],
    [
      "Precondition",
      "element",
      "SetMemberSymbol_Element",
      "self::infixop[contains(@role, \"element\")]"
    ],
    [
      "Specialized",
      "element",
      "SetMemberSymbol_Element",
      "SetMemberSymbol_Belongs"
    ],
    [
      "Precondition",
      "unit-reciprocal-multi",
      "default",
      "self::superscript[@role=\"unit\"]",
      "name(children/*[1])=\"identifier\"",
      "name(children/*[2])=\"prefixop\"",
      "children/*[2][@role=\"negative\"]",
      "children/*[2]/children/*[1][text()=1]",
      "preceding-sibling::*[@role=\"unit\"]"
    ],
    [
      "Alias",
      "interval-open",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"[\""
    ],
    [
      "Alias",
      "interval-closed-open",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"[\"",
      "content/*[2]/text()=\"[\""
    ],
    [
      "Alias",
      "interval-open-closed",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"]\""
    ],
    [
      "Alias",
      "interval-open-inf-r",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"[\"",
      "children/*[1]/children/*[3]/text()=\"∞\" or (name(children/*[1]/children/*[3])=\"prefixop\" and children/*[1]/children/*[3]/children/*[1]/text()=\"∞\")"
    ],
    [
      "Alias",
      "interval-open-inf-l",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"[\"",
      "children/*[1]/children/*[1]/text()=\"∞\" or (name(children/*[1]/children/*[1])=\"prefixop\" and children/*[1]/children/*[1]/children/*[1]/text()=\"∞\")"
    ],
    [
      "Alias",
      "interval-open-inf-lr",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"[\"",
      "children/*[1]/children/*[3]/text()=\"∞\" or (name(children/*[1]/children/*[3])=\"prefixop\" and children/*[1]/children/*[3]/children/*[1]/text()=\"∞\")",
      "children/*[1]/children/*[1]/text()=\"∞\" or (name(children/*[1]/children/*[1])=\"prefixop\" and children/*[1]/children/*[1]/children/*[1]/text()=\"∞\")"
    ],
    [
      "Alias",
      "interval-closed-open-inf",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"[\"",
      "content/*[2]/text()=\"[\"",
      "children/*[1]/children/*[3]/text()=\"∞\" or (name(children/*[1]/children/*[3])=\"prefixop\" and children/*[1]/children/*[3]/children/*[1]/text()=\"∞\")"
    ],
    [
      "Alias",
      "interval-open-closed-inf",
      "self::fenced",
      "contains(@grammar, \"interval\")",
      "content/*[1]/text()=\"]\"",
      "content/*[2]/text()=\"]\"",
      "children/*[1]/children/*[1]/text()=\"∞\" or (name(children/*[1]/children/*[1])=\"prefixop\" and children/*[1]/children/*[1]/children/*[1]/text()=\"∞\")"
    ]
  ]
}
