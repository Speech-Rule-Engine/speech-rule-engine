{
  "extends": "../tsconfig.json",
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./js",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "#js/*": ["../js/*"],
      "#mathjax/*": ["./node_modules/mathjax-full/mjs/*"]
    },
  },
  "types": ["jest"],
  "include": ["ts"]
}
