{
  "name": "sre-tests",
  "version": "1.0.0",
  "description": "Speech Rule Engine tests with Jest",
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "scripts": {
    "compile": "pnpm tsc",
    "prepare": "node tests.config.js",
    "build": "pnpm clean; pnpm prepare && pnpm compile",
    "clean": "pnpm rimraf dist js tests/output tests/json tests/analyse tests/actions coverage",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest"
  },
  "imports": {
    "#js/*": "../js/*",
    "#source/*": "../components/mjs/*",
    "#src/*": "./src/*",
    "#helpers": "./js/src/index.js",
    "#mathjax/*": "mathjax-full/mjs/*",
    "#tests/*": "./js/*"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "firebase-admin": "^13.4.0",
    "jest": "^29.7.0",
    "mathjax-full": "4.0.0-beta.4",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "xml-js": "^1.6.11"
  }
}
